rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Orders ─────────────────────────────────────────────
    // Anyone can CREATE an order (guests + logged-in customers)
    // Only authenticated users (admin) can READ / UPDATE
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'date', 'totalSAR', 'items']);
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // ── Play Videos ────────────────────────────────────────
    // Anyone can READ the feed
    // Only logged-in users can POST videos
    match /play_videos/{videoId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.creatorUid;
    }

    // ── Notifications / FCM tokens ─────────────────────────
    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }
    match /fcm_tokens/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Everything else ────────────────────────────────────
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
